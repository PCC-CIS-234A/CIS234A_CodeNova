<%-
/*
  views/notifications/archive.ejs

  Displays the Notification Archive page.
  Provides filters for date range and search keywords, shows archived notifications
  in a sortable table, and allows managers to export archive results to Excel.
*/
%>

<%- include('../partials/header', { title }) %>

<div class="log-box">
    <h1>Notification Archive</h1>

    <% /* Displays flash messages such as invalid date range errors. */ %>
    <%- include('../partials/flash') %>

    <% /* Filter form for narrowing archived notifications by date range or search term. */ %>
    <form method="GET" action="/notifications/archive" class="filter-bar">
        <div class="filter-field">
            <label class="form-label" for="from">From</label>
            <input
                    type="date"
                    id="from"
                    name="from"
                    class="form-input"
                    value="<%= filters.from || '' %>"
            />
        </div>

        <div class="filter-field">
            <label class="form-label" for="to">To</label>
            <input
                    type="date"
                    id="to"
                    name="to"
                    class="form-input"
                    value="<%= filters.to || '' %>"
            />
        </div>

        <div class="filter-field">
            <label class="form-label" for="search">Search</label>
            <input
                    type="text"
                    id="search"
                    name="search"
                    class="form-input"
                    placeholder="Search by keyword or sender"
                    value="<%= filters.search || '' %>"
            />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-compact">Apply</button>

            <a href="/notifications/archive"
               class="btn btn-compact btn-secondary btn-link-action">
                Clear
            </a>

            <% /* Managers can export the currently filtered archive results to Excel. */ %>
            <% if (currentUser && currentUser.role === "manager") { %>
                <a
                        href="/notifications/archive/export?from=<%= filters.from || '' %>&to=<%= filters.to || '' %>&search=<%= filters.search || '' %>"
                        class="btn btn-compact"
                >
                    Export to Excel
                </a>
            <% } %>
        </div>
    </form>

    <% /* Summary count updates based on the current filter results. */ %>
    <p class="log-summary">
        Showing <%= notifications.length %>
        archived notification<%= notifications.length === 1 ? '' : 's' %>.
    </p>

    <% if (notifications.length === 0) { %>

        <div class="log-empty">
            No archived notifications match the current filter.
        </div>

    <% } else { %>

        <% /* Sortable table of archived notifications. Rows can be clicked for more details. */ %>
        <div class="table-scroll">
            <table class="log-table sortable-table">
                <thead>
                <tr>
                    <th class="sortable-header" data-column="0">Date Sent</th>
                    <th class="sortable-header" data-column="1">Sent By</th>
                    <th class="sortable-header" data-column="2">Subject</th>
                    <th class="sortable-header" data-column="3">Message Body</th>
                    <th class="sortable-header" data-column="4">Recipients</th>
                </tr>
                </thead>

                <tbody>
                <% notifications.forEach((n, index) => { %>
                    <tr
                            class="notification-clickable-row"
                            data-subject="<%= n.subject %>"
                            data-body="<%= n.body %>"
                            data-sender="<%= n.sender_email %>"
                            data-date="<%= n.sent_at_display %>"
                            data-recipients="<%= n.recipient_count %>"
                    >
                        <td class="log-date"><%= n.sent_at_display %></td>

                        <td><%= n.sender_email %></td>

                        <% /* Long subjects are shortened in the table for readability. */ %>
                        <td>
                            <%= n.subject.length > 25
                                    ? n.subject.substring(0, 25) + '...'
                                    : n.subject
                            %>
                        </td>

                        <% /* Message preview is shortened in the table; full text is available in row data/details. */ %>
                        <td class="log-body">
                            <span id="message-preview-<%= index %>">
                                <%= n.body.length > 45
                                        ? n.body.substring(0, 45) + '...'
                                        : n.body
                                %>
                            </span>

                            <span id="message-full-<%= index %>" style="display: none;">
                                <%= n.body %>
                            </span>
                        </td>

                        <td class="log-recipients">
                            <%= n.recipient_count %>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>

        <% /* Details box is populated by script.js when a notification row is selected. */ %>
        <div id="notification-details" class="details-box">
            <h2>Notification Details</h2>

            <div id="details-content">
                <p>Select a notification to view details.</p>
            </div>
        </div>

    <% } %>
</div>

<script src="/script.js"></script>

<%- include('../partials/footer') %>