<%-
/*
  views/notifications/log.ejs

  Displays the Notification Log page.
  Allows users to filter notifications by date range and keyword,
  view notification details, and access the archive page if authorized.
*/
%>

<%- include('../partials/header', { title }) %>

<div class="log-box">
    <h1>Notification Log</h1>

    <% /* Displays success and error messages. */ %>
    <%- include('../partials/flash') %>

    <% /* Filter form for searching notifications by date range and keyword. */ %>
    <form method="GET" action="/notifications/log" class="filter-bar">
        <div class="filter-field">
            <label class="form-label" for="from">From</label>
            <input
                    type="date"
                    id="from"
                    name="from"
                    class="form-input"
                    value="<%= filters.from || '' %>"
            />
        </div>

        <div class="filter-field">
            <label class="form-label" for="to">To</label>
            <input
                    type="date"
                    id="to"
                    name="to"
                    class="form-input"
                    value="<%= filters.to || '' %>"
            />
        </div>

        <div class="filter-field">
            <label class="form-label" for="search">Search</label>
            <input
                    type="text"
                    id="search"
                    name="search"
                    class="form-input"
                    placeholder="Search by keyword or sender"
                    value="<%= filters.search || '' %>"
            />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-compact">Apply</button>

            <a href="/notifications/log"
               class="btn btn-compact btn-secondary btn-link-action">
                Clear
            </a>

            <% /* Managers can access the notification archive page. */ %>
            <% if (currentUser && currentUser.role === "manager") { %>
                <a href="/notifications/archive" class="btn btn-compact">
                    View Archive
                </a>
            <% } %>
        </div>
    </form>

    <% /* Displays the number of notifications matching the current filters. */ %>
    <p class="log-summary">
        Showing <%= notifications.length %>
        notification<%= notifications.length === 1 ? '' : 's' %><% if (filters.from || filters.to) { %>
            between <%= filters.from || 'the beginning' %> and <%= filters.to || 'today' %><% } %>.
    </p>

    <% if (notifications.length === 0) { %>
        <div class="log-empty">No notifications match the current filter.</div>
    <% } else { %>

        <% /* Sortable table displaying notification records. */ %>
        <div class="table-scroll">
            <table class="log-table sortable-table">
                <thead>
                <tr>
                    <th class="sortable-header" data-column="0">Date Sent</th>
                    <th class="sortable-header" data-column="1">Sent By</th>
                    <th class="sortable-header" data-column="2">Subject</th>
                    <th class="sortable-header" data-column="3">Message Body</th>
                    <th class="sortable-header" data-column="4">Recipients</th>
                </tr>
                </thead>

                <tbody>
                <% notifications.forEach((n, index) => { %>
                    <tr
                            class="notification-clickable-row"
                            data-subject="<%= n.subject %>"
                            data-body="<%= n.body %>"
                            data-sender="<%= n.sender_email %>"
                            data-date="<%= n.sent_at_display %>"
                            data-recipients="<%= n.recipient_count %>"
                    >
                        <td class="log-date"><%= n.sent_at_display %></td>
                        <td><%= n.sender_email %></td>
                        <td>
                            <span id="subject-preview-<%= index %>">
                                 <%= n.subject.length > 25
                                         ? n.subject.substring(0, 25) + '...'
                                         : n.subject
                                 %>
                            </span>

                            <span id="subject-full-<%= index %>" style="display: none;">
                                <%= n.subject %>
                            </span>
                        </td>

                        <% /* Long message bodies are truncated for readability and expanded when selected. */ %>
                        <td class="log-body">
                            <span id="message-preview-<%= index %>">
                                <%= n.body.length > 25
                                        ? n.body.substring(0, 25) + '...'
                                        : n.body
                                %>
                            </span>

                            <span id="message-full-<%= index %>" style="display: none;">
                                <%= n.body %>
                            </span>
                        </td>

                        <td class="log-recipients"><%= n.recipient_count %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>

        <% /* Details panel populated by script.js when a notification row is selected. */ %>
        <div id="notification-details" class="details-box">
            <h2>Notification Details</h2>

            <div id="details-content">
                <p>Select a notification to view details.</p>
            </div>
        </div>
    <% } %>
</div>

<script src="/script.js"></script>

<%- include('../partials/footer') %>