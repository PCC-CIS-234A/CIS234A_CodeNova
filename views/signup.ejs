<%- include('partials/header', { title }) %>

<div class="card">
  <h1>Create Account</h1>

  <%- include('partials/flash') %>

  <form method="POST" action="/signup">
    <div class="form-group">
      <label for="signup-username" class="form-label">Username</label>
      <input
        type="text"
        id="signup-username"
        name="username"
        class="form-input"
        placeholder="3-30 characters: letters, numbers, . _ -"
        value="<%= (form && form.username) || '' %>"
        pattern="[A-Za-z0-9._\-]{3,30}"
        title="3-30 characters: letters, numbers, dot, underscore, or hyphen"
        autocomplete="username"
        required
      />
    </div>

    <div class="form-group">
      <label for="signup-first-name" class="form-label">First name</label>
      <input
        type="text"
        id="signup-first-name"
        name="first_name"
        class="form-input"
        value="<%= (form && form.first_name) || '' %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="signup-last-name" class="form-label">Last name</label>
      <input
        type="text"
        id="signup-last-name"
        name="last_name"
        class="form-input"
        value="<%= (form && form.last_name) || '' %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="signup-email" class="form-label">Email address</label>
      <input
        type="email"
        id="signup-email"
        name="email"
        class="form-input"
        value="<%= (form && form.email) || '' %>"
        required
      />
    </div>

    <% /* ----- Saul Sprint 2: account type dropdown and multi-select list checkboxes ----- */ %>
    <% const selectedSignupRole = (form && form.signup_role) ? form.signup_role : 'student'; %>
    <div class="form-group">
      <label for="signup-role" class="form-label">Account type</label>
      <select id="signup-role" name="signup_role" class="form-input">
        <option value="student" <%= selectedSignupRole === 'student' ? 'selected' : '' %>>Student (Subscriber)</option>
        <option value="manager" <%= selectedSignupRole === 'manager' ? 'selected' : '' %>>Manager</option>
        <option value="staff" <%= selectedSignupRole === 'staff' ? 'selected' : '' %>>Staff</option>
      </select>
    </div>

    <div id="campus-list-section" class="form-group campus-list-section<%= selectedSignupRole === 'student' ? '' : ' is-hidden' %>">
      <fieldset class="choice-group">
        <legend class="form-label">Subscriber lists (select one or more)</legend>
        <% const selectedListIds = (form && form.selectedListIds) ? form.selectedListIds.map(String) : []; %>
        <% if (typeof subscriberLists !== 'undefined' && subscriberLists && subscriberLists.length) { %>
          <% subscriberLists.forEach(function(list) { %>
          <label class="choice-option">
            <input
              type="checkbox"
              name="list_ids"
              value="<%= list.id %>"
              <%= selectedListIds.includes(String(list.id)) ? 'checked' : '' %>
            />
            <span><%= list.name %></span>
          </label>
          <% }); %>
        <% } else { %>
          <p class="profile-empty">No subscriber lists are available yet.</p>
        <% } %>
      </fieldset>
      <p id="signup-list-error" class="form-inline-error is-hidden" role="alert">Select at least one subscriber list.</p>
    </div>
    <% /* ----- end Saul Sprint 2 ----- */ %>

    <div class="form-group">
      <label for="signup-password" class="form-label">Password</label>
      <div class="password-wrapper">
        <input type="password" id="signup-password" name="password" class="form-input" placeholder="Min 8 chars with 1 uppercase, 1 number & 1 symbol" title="At least 8 characters, with one uppercase letter, one number, and one special character." required />
        <button type="button" class="eye-btn" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="form-group">
      <label for="signup-confirm" class="form-label">Confirm password</label>
      <div class="password-wrapper">
        <input type="password" id="signup-confirm" name="confirm_password" class="form-input" required />
        <button type="button" class="eye-btn" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>

    <button type="submit" class="btn">Create Account</button>

    <div class="form-secondary-actions">
      <button type="reset" class="btn btn-compact btn-secondary">Clear</button>
    </div>
  </form>

  <div class="small-text">
    Already have an account?
    <a href="/login">Login here</a>
  </div>
</div>

<script src="/password-toggle.js"></script>
<script src="/signup-role.js"></script>
<%- include('partials/footer') %>
