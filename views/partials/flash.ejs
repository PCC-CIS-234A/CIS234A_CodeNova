<!-- Shows manually passed flash message, used when rendering the same page. -->
<% if (typeof flash !== "undefined" && flash) { %>
  <div class="flash <%= flash.type %>">
    <%= flash.message %>
  </div>
<% } %>

<!-- Shows success flash messages added through req.flash. -->
<% if (messages && messages.success) { %>
  <% messages.success.forEach((message) => { %>
    <div class="flash success"><%= message %></div>
  <% }) %>
<% } %>

<!-- Shows error flash messages added through req.flash. -->
<% if (messages && messages.error) { %>
  <% messages.error.forEach((message) => { %>
    <div class="flash error"><%= message %></div>
  <% }) %>
<% } %>