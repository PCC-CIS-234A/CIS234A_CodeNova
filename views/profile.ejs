<% /* ----- Saul Sprint 2: profile page (lists for students and managers) ----- */ %>
<%- include('partials/header', { title }) %>
<div class="card card-wide">
  <h1>Profile</h1>

  <%- include('partials/flash') %>

  <div class="profile-summary">
    <p><strong>Name:</strong> <%= currentUser.first_name %> <%= currentUser.last_name %></p>
    <p><strong>Email:</strong> <%= currentUser.email %></p>
    <p><strong>Role:</strong> <%= currentUser.role === 'subscriber' ? 'Student (Subscriber)' : currentUser.role %></p>
  </div>

  <% const _profileRole = String(currentUser.role || '').trim().toLowerCase(); %>

  <% /* ----- Saul Sprint 2: student picks which lists get emails ----- */ %>
  <% if (_profileRole === 'subscriber') { %>
  <section class="profile-section">
    <h2>My Subscriptions</h2>
    <p class="profile-help">Choose one or more lists to receive pantry notifications from. Manager-created lists appear here too. Uncheck a box to unsubscribe.</p>

    <% /* form posts checked list_ids to /profile/subscriptions */ %>
    <form method="POST" action="/profile/subscriptions">
      <%- include('partials/subscriberListPicker', {
        pickerId: 'profile-subscription-picker',
        lists: profile.subscriberLists || [],
        selectedIds: profile.subscribedListIds || [],
        layout: 'stack',
        legend: 'Subscriber lists (select one or more)'
      }) %>

      <button type="submit" class="btn profile-form-submit">Save Subscriptions</button>
    </form>
  </section>
  <% } %>

  <% /* ----- Saul Sprint 2: manager creates and removes lists ----- */ %>
  <% if (profile.isManagerProfile) { %>
  <section class="profile-section">
    <h2>Manage Subscriber Lists</h2>
    <p class="profile-help">Create new lists for students to subscribe to during account creation and on their profile page.</p>

    <% /* type a name and post to /profile/lists */ %>
    <form method="POST" action="/profile/lists" class="profile-create-list-form">
      <div class="form-group">
        <label for="list-name" class="form-label">New list name</label>
        <input
          type="text"
          id="list-name"
          name="list_name"
          class="form-input"
          maxlength="100"
          placeholder="e.g. Extended Hours Volunteers"
          required
        />
      </div>
      <button type="submit" class="btn">Create List</button>
    </form>

    <% if (profile.subscriberLists && profile.subscriberLists.length) { %>
    <h3 class="profile-subheading">Existing lists</h3>
    <p class="profile-help">Select one or more lists below, then choose Remove Selected. All Subscribers cannot be removed.</p>

    <% /* check lists to delete, then post to /profile/lists/delete */ %>
    <form method="POST" action="/profile/lists/delete" id="manager-remove-lists-form">
      <% /* All Subscribers shows as a label only — not in the delete list */ %>
      <% const managerRemovableLists = (profile.subscriberLists || []).filter(function(list) {
        return list.name !== 'All Subscribers';
      }); %>
      <%- include('partials/subscriberListPicker', {
        pickerId: 'manager-remove-picker',
        lists: managerRemovableLists,
        selectedIds: [],
        layout: 'inline',
        legend: 'Subscriber lists',
        checkboxClass: 'manager-list-remove-cb',
        staticEntries: [{ name: 'All Subscribers' }]
      }) %>

      <button
        type="submit"
        id="remove-selected-lists-btn"
        class="btn profile-remove-selected-btn profile-form-submit is-hidden"
      >
        Remove Selected
      </button>
    </form>
    <% } %>
  </section>
  <% } %>
  <% /* ----- end Saul Sprint 2 ----- */ %>
</div>
<% /* load list picker JS for search, sort, show more, remove button */ %>
<% if (profile.isManagerProfile || _profileRole === 'subscriber') { %>
<script src="/subscriber-list-picker.js"></script>
<% } %>

<%- include('partials/footer') %>
