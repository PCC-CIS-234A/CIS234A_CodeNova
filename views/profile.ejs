<% /* Saul Sprint 2 — profile page (student subscriptions + manager list admin) */ %>
<%- include('partials/header', { title }) %>

<div class="card card-wide">
  <h1>Profile</h1>

  <%- include('partials/flash') %>

  <div class="profile-summary">
    <p><strong>Name:</strong> <%= currentUser.first_name %> <%= currentUser.last_name %></p>
    <p><strong>Email:</strong> <%= currentUser.email %></p>
    <p><strong>Role:</strong> <%= currentUser.role === 'subscriber' ? 'Student (Subscriber)' : currentUser.role %></p>
  </div>

  <% const _profileRole = String(currentUser.role || '').trim().toLowerCase(); %>

  <% /* ----- Saul Sprint 2: student subscription management ----- */ %>
  <% if (_profileRole === 'subscriber') { %>
  <section class="profile-section">
    <h2>My Subscriptions</h2>
    <p class="profile-help">Choose one or more lists to receive pantry notifications from. Manager-created lists appear here too. Uncheck a box to unsubscribe.</p>

    <form method="POST" action="/profile/subscriptions">
      <% if (profile.subscriberLists && profile.subscriberLists.length) { %>
      <fieldset class="choice-group">
        <legend class="form-label">Subscriber lists (select one or more)</legend>
        <% profile.subscriberLists.forEach(function(list) { %>
        <% const isChecked = (profile.subscribedListIds || []).includes(list.id); %>
        <label class="choice-option">
          <input
            type="checkbox"
            name="list_ids"
            value="<%= list.id %>"
            <%= isChecked ? 'checked' : '' %>
          />
          <span><%= list.name %></span>
        </label>
        <% }); %>
      </fieldset>
      <% } else { %>
      <p class="profile-empty">No subscriber lists are available yet.</p>
      <% } %>

      <button type="submit" class="btn">Save Subscriptions</button>
    </form>
  </section>
  <% } %>
  <% /* ----- end Saul Sprint 2 ----- */ %>

  <% /* ----- Saul Sprint 2: manager list creation ----- */ %>
  <% if (profile.isManagerProfile) { %>
  <section class="profile-section">
    <h2>Manage Subscriber Lists</h2>
    <p class="profile-help">Create new lists for students to subscribe to during account creation and on their profile page.</p>

    <form method="POST" action="/profile/lists" class="profile-create-list-form">
      <div class="form-group">
        <label for="list-name" class="form-label">New list name</label>
        <input
          type="text"
          id="list-name"
          name="list_name"
          class="form-input"
          maxlength="100"
          placeholder="e.g. Extended Hours Volunteers"
          required
        />
      </div>
      <button type="submit" class="btn">Create List</button>
    </form>

    <% if (profile.subscriberLists && profile.subscriberLists.length) { %>
    <h3 class="profile-subheading">Existing lists</h3>
    <ul class="profile-list-names">
      <% profile.subscriberLists.forEach(function(list) { %>
      <li class="profile-list-row">
        <span><%= list.name %></span>
        <% if (list.name !== 'All Subscribers') { %>
        <form method="POST" action="/profile/lists/delete" class="inline-form profile-remove-list-form">
          <input type="hidden" name="list_id" value="<%= list.id %>" />
          <button
            type="submit"
            class="profile-remove-btn"
            onclick="return confirm('Remove &quot;<%= list.name %>&quot;? Students subscribed to this list will be unsubscribed.');"
          >
            Remove
          </button>
        </form>
        <% } %>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </section>
  <% } %>
  <% /* ----- end Saul Sprint 2 ----- */ %>

  <div class="form-secondary-actions">
    <a href="/" class="btn btn-compact btn-secondary btn-link-action">Back to Home</a>
  </div>
</div>

<%- include('partials/footer') %>
